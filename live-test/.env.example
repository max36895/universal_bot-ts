# umbot live-test — скопируйте в live-test/.env и заполните нужные платформы.
# Файл .env в git не попадает (см. .gitignore). Токены не покидают ваш сервер.

# ── Общие ───────────────────────────────────────────────────────────────
# Адрес и порт webhook-режима
LIVE_HOST=0.0.0.0
LIVE_PORT=3000
# Публичный HTTPS-адрес для регистрации webhook (режим register)
LIVE_PUBLIC_URL=https://example.com/umbot
# Ключ Yandex SpeechKit (API-ключ сервисного аккаунта) — голос в Telegram/VK/MAX
SPEECH_KIT_TOKEN=
# Свои картинки вместо сгенерированных (необязательно)
LIVE_IMAGE_1=
LIVE_IMAGE_2=
LIVE_IMAGE_3=
# Картинка по URL — нужна SmartApp (он показывает изображения только по ссылке)
LIVE_IMAGE_URL=

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Ваш chat_id: сначала напишите боту
LIVE_TELEGRAM_CHAT_ID=

# ── VK ──────────────────────────────────────────────────────────────────
VK_TOKEN=
VK_CONFIRMATION_TOKEN=
VK_SECRET_KEY=
# Ваш числовой id VK: сначала напишите сообществу
LIVE_VK_USER_ID=

# ── MAX ─────────────────────────────────────────────────────────────────
MAX_TOKEN=
MAX_WEBHOOK_SECRET=
# Ваш user_id: сначала нажмите «Начать» у бота
LIVE_MAX_USER_ID=

# ── Viber ───────────────────────────────────────────────────────────────
VIBER_TOKEN=
VIBER_SENDER=umbot live-test
# Ваш Viber id: вы должны быть подписаны на бота
LIVE_VIBER_USER_ID=

# ── Алиса ───────────────────────────────────────────────────────────────
# OAuth-токен Яндекс.Диалогов и skill_id — для загрузки картинок/звуков
ALISA_TOKEN=
ALISA_SKILL_ID=

# ── Маруся ──────────────────────────────────────────────────────────────
MARUSIA_TOKEN=
