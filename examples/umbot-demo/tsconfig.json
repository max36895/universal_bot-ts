{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2023",
        "lib": ["ES2023", "DOM"],
        "moduleResolution": "Node16",
        "removeComments": true,
        "sourceMap": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "types": ["node", "jest"]
    },
    // Тесты компилирует ts-jest со своими настройками из этого же файла;
    // в dist/ они не попадают, чтобы не менять пути запуска (dist/dev.js).
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "tests"]
}
